[alias]
	search = "!f() { git log --oneline -S\"$1\"; }; f"
	between = "!f() { git log --oneline \"$1\"..\"${2:-HEAD}\"; }; f"
	dc = diff --cached
	s = status -sb
	lg = log --graph --oneline --decorate --all
	last = log -1 HEAD --stat
	undo = reset --soft HEAD~1
	unstage = reset -q HEAD --
	amend = commit --amend --no-edit
	pushf = push --force-with-lease
	sync = !git fetch --all --prune && git rebase --autostash @{u}
	cleanup = !git branch --merged | grep -vE \"^\\*|master|main\" | xargs -r git branch -d
	recent = for-each-ref --count=15 --sort=-committerdate refs/heads/ --format=%(refname:short)
	d = "!f() { target=$1; step=$2; n=${step#[+-]}; case \"$step\" in -*) git diff \"$target~${n}\" \"$target\";; *) child=$(git rev-list --ancestry-path \"$target\"..HEAD | tac | sed -n \"${n}p\"); if [ -z \"$child\" ]; then echo \"Error: +$n commit not found.\"; else git diff \"$target\" \"$child\"; fi;; esac; }; f"
